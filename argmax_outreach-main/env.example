# Copy the values you need. Real secrets belong in `wrangler secret put`, never here
# or in wrangler.toml. Non-secret values go in wrangler.toml's [vars] section.

# --- Core send safety ------------------------------------------------------------
SEND_MODE=dry_run
DAILY_SEND_LIMIT=10
REPLY_SYNC_MAX_AGE_MINUTES=30

# --- Discovery --------------------------------------------------------------------
DISCOVERY_ENABLED=true
YC_ENABLED=true

# --- Enrichment / contact adapters -------------------------------------------------
# Nothing below is required. With none of it set, enrichment/contacts run entirely on
# free, no-key paths: website scraping + Clearbit-autocomplete/DuckDuckGo domain
# resolution + DNS-based email verification. See README "Free-tier-first enrichment".
ENRICHMENT_API_URL=
ENRICHMENT_API_TOKEN=
FUNDING_PROVIDER_API_URL=
FUNDING_PROVIDER_API_TOKEN=
CONTACT_PROVIDER_API_URL=
CONTACT_PROVIDER_API_TOKEN=

# Hunter.io free plan (~25-50 searches/month depending on current plan terms --
# check https://hunter.io/pricing). Self-throttled against HUNTER_MONTHLY_BUDGET via
# the existing usage_ledger table, so it can never silently exceed the free tier.
HUNTER_API_KEY=
HUNTER_MONTHLY_BUDGET=45

# Apollo.io free plan (people search only; email-revealing match_person is not wired
# by default -- see README). Check https://www.apollo.io/pricing for current limits.
APOLLO_API_KEY=
APOLLO_MONTHLY_BUDGET=100

# Real SMTP-level (RCPT-TO) email verification. Cloudflare Workers cannot do this
# themselves -- outbound TCP on port 25 is blocked by the Workers runtime -- so this
# points at an external HTTP service that can, e.g. a deployed instance of your own
# Reacher/startup-tracker project (see its new POST /api/verify-email in this
# delivery). Optional; falls back to the free DNS-only check if unset.
SMTP_VERIFY_API_URL=
SMTP_VERIFY_API_KEY=

# --- AI provider chain (primary -> fallback -> tertiary) ---------------------------
# Every default below is chosen to run entirely within a genuinely free tier -- no
# paid usage is assumed anywhere in this project. All three are optional; research
# and personalization gracefully degrade to deterministic/blocked behavior if nothing
# is configured. See README "Free-tier AI provider chain" for current limits and links.
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-2.0-flash
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
AI_TERTIARY_PROVIDER=cloudflare
AI_TERTIARY_MODEL=@cf/zai-org/glm-4.7-flash
AI_MAX_RETRIES=2
AI_MAX_INPUT_TOKENS=5000
AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.2
GEMINI_API_KEY=
GROQ_API_KEY=
# Cloudflare Workers AI needs no key -- it uses the [ai] binding in wrangler.toml,
# and its free monthly allocation is bundled with every Workers account.

AUTO_SEND_ENABLED=false

# --- Lead scoring / thresholds -----------------------------------------------------
LEAD_QUALIFICATION_THRESHOLD=75
HIGH_VALUE_LEAD_THRESHOLD=70
MAX_DAILY_EMAILS=10
MAX_EMAILS_PER_DOMAIN=1
MAX_EMAILS_PER_CONTACT=3

# --- Email provider ----------------------------------------------------------------
EMAIL_API_URL=
EMAIL_API_TOKEN=
SENDER_EMAIL=
SENDER_NAME=
SENDER_POSTAL_ADDRESS=

# --- Notifications (dashboard feed always works; external channels are optional) --
NOTIFICATION_PROVIDER=
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# --- Admin/auth ---------------------------------------------------------------------
ADMIN_TOKEN=
WEBHOOK_SECRET=
